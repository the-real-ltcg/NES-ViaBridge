{
  "schemaVersion": 1,
  "id": "nes-viabridge",
  "version": "${version}",
  "name": "NES ViaBridge",
  "description": "Companion mod for Not Enough Spectators that lets spectators on other Minecraft versions connect to a 26.2 host, using the ViaVersion / ViaBackwards / ViaRewind stack.",
  "authors": [
    "the-real-ltcg"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/nes-via-bridge",
    "sources": "https://github.com/the-real-ltcg/NES-ViaBridge",
    "issues": "https://github.com/the-real-ltcg/NES-ViaBridge/issues"
  },
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "main": [
      "cheeezer.viabridge.NESViaBridge"
    ],
    "client": [
      "cheeezer.viabridge.NESViaBridgeClient"
    ]
  },
  "mixins": [
    {
      "config": "nes-viabridge.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": ">=26.2",
    "java": ">=25",
    "not-enough-spectators": "*"
  },
  "breaks": {
    "viafabric": "*",
    "viafabricplus": "*",
    "viaversion": "*",
    "viabackwards": "*",
    "viarewind": "*"
  }
}
